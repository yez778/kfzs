# 应用配置
APP_NAME=doudian-agent
ENV=development
SECRET_KEY=please-change-me-to-a-long-random-string
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

DATABASE_URL=sqlite+aiosqlite:///./doudian.db
# 云托管 MySQL：本机保持空；控制台给 prod 配 MYSQL_ADDRESS / MYSQL_USERNAME / MYSQL_PASSWORD
MYSQL_ADDRESS=
MYSQL_USERNAME=
MYSQL_PASSWORD=
MYSQL_DATABASE=doudian
REDIS_URL=redis://localhost:6379/0
CHROMA_PERSIST_DIR=./chroma_data
CHROMA_URL=

LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_TEMPERATURE=0.2

EMBEDDING_PROVIDER=onnx
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
# ONNX 嵌入模型（all-MiniLM-L6-v2，约 87MB）按需下载
# 默认启用（不填也能下）；设为 0 可彻底关闭，关闭后检索退回哈希嵌入
CHROMA_DOWNLOAD_ONNX=1
# 可选：换成镜像/内网下载源，留空用 chromadb 官方源
CHROMA_ONNX_MODEL_URL=

DOUDIAN_PROVIDER=mock
DOUDIAN_APP_KEY=
DOUDIAN_APP_SECRET=
DOUDIAN_ACCESS_TOKEN=
DOUDIAN_REFRESH_TOKEN=
DOUDIAN_BASE_URL=https://openapi-fxg.jinritemai.com

RELEVANCE_THRESHOLD=0.1

# 限流（按 IP+路径滑动窗口；登录接口更严格）
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=180
LOGIN_RATE_LIMIT_PER_MINUTE=10
# 生产建议配置信任主机（逗号分隔），* 表示不限制
ALLOWED_HOSTS=*

ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123456
STAFF_USERNAME=staff
STAFF_PASSWORD=Staff@123456
CUSTOMER_USERNAME=customer
CUSTOMER_PASSWORD=Customer@123

WECHAT_APPID=wx2aa5f2c85393e806
WECHAT_SECRET=

# 微信支付：PAYMENT_MODE=v2sandbox 走本地模拟（默认，可一键支付成功，不触达微信）；
# PAYMENT_MODE=v2sandbox 走官方 V2 仿真测试系统（真实请求 sandboxnew 接口，仅后端联调）。
PAYMENT_ENABLED=true
PAYMENT_MODE=v2sandbox
PAYMENT_APPID=
PAYMENT_MCH_ID=1900000000
PAYMENT_MCH_KEY=sandbox-mch-key-change-me
PAYMENT_NOTIFY_URL=
PAYMENT_ORDER_EXPIRE_MINUTES=15
# 仅 PAYMENT_MODE=v2sandbox 需要：真实商户号 + 真实 APIv2 密钥 + 一个真实测试 openid
PAYMENT_API_V2_KEY=
PAYMENT_SANDBOX_OPENID=
