# AI 客服服务配置
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
KNOWLEDGE_FILE=data/knowledge.md

# 工具调用：查订单/物流（需与 server 的 SERVICE_TOKEN 一致，server 未配置则工具降级为空）
SERVER_API_BASE=http://127.0.0.1:8000/api/v1
SERVICE_TOKEN=
# 会话持久化文件（默认 data/sessions.json）
SESSION_STORE=data/sessions.json
