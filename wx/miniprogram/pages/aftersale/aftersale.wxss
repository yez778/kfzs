/* 售后申请 · 极简橙 */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 20rpx 0 160rpx;
}

.card {
  margin: 0 24rpx 20rpx;
  padding: 28rpx;
}

/* 订单信息 */
.ob-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 18rpx;
}
.ob-row {
  display: flex;
  padding: 12rpx 0;
}
.ob-label {
  width: 160rpx;
  color: var(--muted);
  font-size: 26rpx;
  flex-shrink: 0;
}
.ob-value {
  flex: 1;
  color: var(--text-2);
  font-size: 26rpx;
  word-break: break-all;
}

/* 分区标题 */
.sec-title {
  font-size: 30rpx;
  font-weight: 700;
  margin-bottom: 22rpx;
}
.req { color: var(--danger); }

/* 售后类型 */
.action-list {
  display: flex;
  flex-direction: column;
}
.action-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  border: 2rpx solid #eeeeee;
  border-radius: 12rpx;
  margin-bottom: 16rpx;
}
.action-item:last-child { margin-bottom: 0; }
.action-item.on {
  border-color: var(--brand);
  background: var(--brand-bg);
}
.ai-main { flex: 1; }
.ai-name {
  font-size: 28rpx;
  font-weight: 600;
  color: var(--text);
}
.ai-desc {
  font-size: 23rpx;
  color: var(--muted);
  margin-top: 6rpx;
}
.ai-check {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--brand);
  color: #fff;
  font-size: 28rpx;
}
.action-item:not(.on) .ai-check {
  background: transparent;
  color: transparent;
  border: 2rpx solid #dddddd;
  box-sizing: border-box;
}

/* 快捷原因 */
.quick-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-bottom: 20rpx;
}
.quick {
  font-size: 24rpx;
  color: var(--text-2);
  background: #f5f5f5;
  border-radius: 30rpx;
  padding: 10rpx 26rpx;
}
.reason-input {
  width: 100%;
  box-sizing: border-box;
  height: 200rpx;
  background: #f7f7f7;
  border-radius: 12rpx;
  padding: 22rpx;
  font-size: 27rpx;
}
.counter {
  text-align: right;
  font-size: 22rpx;
  color: var(--muted);
  margin-top: 10rpx;
}

/* 售后记录 */
.rec-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.rec-item:last-child { border-bottom: none; }
.rec-top {
  display: flex;
  justify-content: space-between;
}
.rec-order { font-size: 23rpx; color: var(--muted); }
.rec-status { font-size: 23rpx; color: var(--brand); }
.rec-mid {
  display: flex;
  justify-content: space-between;
  margin: 10rpx 0;
}
.rec-action { font-size: 27rpx; font-weight: 600; }
.rec-amount { font-size: 28rpx; }
.rec-reason {
  font-size: 24rpx;
  color: var(--text-2);
  line-height: 1.5;
}

.tip {
  margin: 10rpx 24rpx;
  font-size: 22rpx;
  color: var(--muted);
  line-height: 1.6;
}
.bottom-space { height: 40rpx; }

/* 提交栏 */
.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #fff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
}
.submit-btn {
  width: 100%;
}
