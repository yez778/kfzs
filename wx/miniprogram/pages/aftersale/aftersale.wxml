<view class="page">
  <!-- 订单信息 -->
  <view class="card order-box">
    <view class="ob-title">售后订单</view>
    <view class="ob-row">
      <text class="ob-label">订单号</text>
      <text class="ob-value mono">{{orderId}}</text>
    </view>
    <view class="ob-row" wx:if="{{product}}">
      <text class="ob-label">商品</text>
      <text class="ob-value">{{product}}</text>
    </view>
    <view class="ob-row" wx:if="{{amount}}">
      <text class="ob-label">订单金额</text>
      <text class="ob-value price">¥{{amount}}</text>
    </view>
  </view>

  <!-- 售后类型 -->
  <view class="card sec">
    <view class="sec-title">售后类型</view>
    <view class="action-list">
      <view wx:for="{{actions}}" wx:key="code"
            class="action-item {{actionIndex===index?'on':''}}"
            data-index="{{index}}" bindtap="onActionTap">
        <view class="ai-main">
          <view class="ai-name">{{item.name}}</view>
          <view class="ai-desc">{{item.desc}}</view>
        </view>
        <view class="ai-check">{{actionIndex===index?'✓':''}}</view>
      </view>
    </view>
  </view>

  <!-- 原因 -->
  <view class="card sec">
    <view class="sec-title">申请原因 <text class="req">*</text></view>
    <view class="quick-row">
      <text class="quick" data-text="收到商品有轻微划痕，申请退款" bindtap="onQuickReason">有划痕</text>
      <text class="quick" data-text="尺寸不合适，想退货退款" bindtap="onQuickReason">尺寸不合适</text>
      <text class="quick" data-text="与描述不符，申请退货退款" bindtap="onQuickReason">与描述不符</text>
      <text class="quick" data-text="还没收到货，申请退款" bindtap="onQuickReason">未收到货</text>
    </view>
    <textarea class="reason-input" value="{{reason}}" bindinput="onReasonInput"
              maxlength="500" placeholder="请描述具体问题（2-500 字），便于商家快速审核" />
    <view class="counter">{{reason.length}}/500</view>
  </view>

  <!-- 我的售后记录 -->
  <view class="card sec" wx:if="{{records.length}}">
    <view class="sec-title">我的售后记录</view>
    <view class="rec-item" wx:for="{{records}}" wx:key="id">
      <view class="rec-top">
        <text class="rec-order mono">{{item.order_id}}</text>
        <text class="rec-status">{{statusText[item.status] || item.status}}</text>
      </view>
      <view class="rec-mid">
        <text class="rec-action">{{actionText[item.action] || item.action}}</text>
        <text class="rec-amount price">¥{{item.amount}}</text>
      </view>
      <view class="rec-reason">{{item.reason}}</view>
    </view>
  </view>

  <view class="tip">提交后进入商家审核，审核通过 1-3 个工作日原路退款；如有疑问可在「AI客服」咨询</view>

  <view class="bottom-space"></view>
  <view class="submit-bar">
    <button class="btn btn-primary submit-btn" bindtap="submit" disabled="{{submitting}}">
      {{submitting ? '提交中…' : '提交售后申请'}}
    </button>
  </view>
</view>
