<!--
  电商首页 · 极简风格
  结构：顶部搜索区 / 横向分类导航 / 双列商品网格
-->
<view class="page">

  <!-- ===== 顶部搜索区 ===== -->
  <view class="header">
    <view class="search-bar">
      <text class="search-icon">🔍</text>
      <input
        class="search-input"
        type="text"
        placeholder="搜索商品"
        placeholder-class="search-placeholder"
        confirm-type="search"
        value="{{keyword}}"
        bindinput="onSearchInput"
        bindconfirm="onSearchConfirm"
      />
      <text wx:if="{{keyword}}" class="search-clear" catchtap="onClearSearch">✕</text>
    </view>
  </view>

  <!-- ===== 分类导航（横向滚动） ===== -->
  <scroll-view class="cat-nav" scroll-x enhanced show-scrollbar="{{false}}">
    <view class="cat-list">
      <view
        wx:for="{{categories}}"
        wx:key="code"
        class="cat-item {{activeCategory === item.code ? 'cat-item--active' : ''}}"
        data-code="{{item.code}}"
        bindtap="onCategoryTap"
      >{{item.name}}</view>
    </view>
  </scroll-view>

  <!-- ===== 商品双列网格（flex-wrap + space-between） ===== -->
  <view class="goods-grid" wx:if="{{products.length > 0}}">
    <view
      wx:for="{{products}}"
      wx:key="product_id"
      class="goods-card"
      data-id="{{item.product_id}}"
      bindtap="onProductTap"
      hover-class="goods-card--hover"
    >
      <!-- 固定 1:1 比例主图 -->
      <view class="goods-thumb">
        <image
          class="goods-img"
          src="{{item.cover}}"
          mode="aspectFill"
          lazy-load
        />
      </view>

      <view class="goods-info">
        <!-- 标题：加粗，最多两行，超出省略 -->
        <view class="goods-title">{{item.title}}</view>

        <!-- 价格 / 销量：两端对齐 -->
        <view class="goods-bottom">
          <text class="goods-price">¥{{item.price}}</text>
          <text class="goods-sales">已售 {{item.sales_text}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- ===== 空态 / 加载态 ===== -->
  <view class="empty" wx:if="{{!loading && products.length === 0}}">
    <text class="empty-icon">🛍</text>
    <text class="empty-text">暂无相关商品</text>
  </view>

  <view class="loading-more" wx:if="{{loading}}">加载中…</view>
  <view class="loading-more" wx:elif="{{!hasMore && products.length > 0}}">— 没有更多了 —</view>

</view>
