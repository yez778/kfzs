/* 我的 · 极简橙 */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 40rpx;
}

/* ===== 未登录 Hero ===== */
.login-hero {
  background: var(--brand-grad);
  padding: 110rpx 48rpx 90rpx;
  border-radius: 0 0 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.hero-avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 36rpx;
  overflow: hidden;
  border: 4rpx solid rgba(255, 255, 255, 0.6);
  background: #fff;
}
.hero-avatar image { width: 100%; height: 100%; }
.hero-title {
  color: #fff;
  font-size: 38rpx;
  font-weight: 800;
  margin-top: 26rpx;
}
.hero-sub {
  color: rgba(255, 255, 255, 0.85);
  font-size: 25rpx;
  margin-top: 12rpx;
}
.wx-login-btn {
  width: 480rpx;
  height: 88rpx;
  line-height: 88rpx;
  margin-top: 44rpx;
  background: #fff;
  color: var(--brand);
  font-weight: 700;
  box-shadow: 0 10rpx 26rpx rgba(0, 0, 0, 0.15);
}
.hero-tip {
  margin-top: 22rpx;
  font-size: 21rpx;
  color: rgba(255, 255, 255, 0.75);
  text-align: center;
}

/* ===== 已登录用户卡 ===== */
.user-card {
  background: var(--brand-grad);
  margin: 0 24rpx;
  padding: 40rpx 32rpx;
  border-radius: 0 0 28rpx 28rpx;
  display: flex;
  align-items: center;
  flex-wrap: wrap;
}
.user-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 30rpx;
  overflow: hidden;
  border: 3rpx solid rgba(255, 255, 255, 0.6);
  background: #fff;
  flex-shrink: 0;
}
.user-avatar image { width: 100%; height: 100%; }
.user-info {
  margin-left: 24rpx;
  flex: 1;
  min-width: 0;
}
.user-name {
  color: #fff;
  font-size: 36rpx;
  font-weight: 800;
}
.user-role {
  display: inline-block;
  margin-top: 10rpx;
  font-size: 21rpx;
  color: var(--brand);
  background: #fff;
  border-radius: 8rpx;
  padding: 4rpx 16rpx;
  font-weight: 600;
}
.wallet {
  width: 100%;
  margin-top: 30rpx;
  background: rgba(255, 255, 255, 0.16);
  border-radius: 16rpx;
  padding: 22rpx 26rpx;
}
.wallet-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.85);
}
.wallet-value {
  font-size: 44rpx;
  font-weight: 800;
  color: #fff;
  margin-top: 4rpx;
}

/* ===== 菜单 ===== */
.menu {
  margin: 24rpx;
  padding: 0 28rpx;
}
.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 2rpx solid var(--line);
}
.menu-item:last-child { border-bottom: none; }
.menu-icon {
  font-size: 38rpx;
  width: 60rpx;
}
.menu-text {
  flex: 1;
  font-size: 29rpx;
  color: var(--text);
  margin-left: 14rpx;
}
.menu-arrow {
  color: #c5c5c5;
  font-size: 38rpx;
}
.menu-hover { background: #fafafa; }

/* ===== 退出登录 ===== */
.logout-btn {
  width: calc(100% - 48rpx);
  margin: 8rpx 24rpx 0;
  background: #fff;
}

.foot-tip {
  text-align: center;
  font-size: 21rpx;
  color: var(--muted);
  margin-top: 48rpx;
}
