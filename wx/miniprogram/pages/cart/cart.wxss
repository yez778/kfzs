/* 购物车 · 极简橙 */
.page {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 160rpx;
}

.cart-list {
  padding: 20rpx 24rpx 0;
}
.cart-item {
  display: flex;
  align-items: center;
  padding: 24rpx;
  margin-bottom: 20rpx;
  position: relative;
}
.cart-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 12rpx;
  background: #f7f7f7;
  flex-shrink: 0;
}
.cart-info {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
  align-self: stretch;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
}
.cart-title {
  font-size: 27rpx;
  color: var(--text);
  font-weight: 600;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.cart-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.cart-price-row .price {
  font-size: 34rpx;
}
.cart-del {
  position: absolute;
  top: 12rpx;
  right: 16rpx;
  color: #c0c0c0;
  font-size: 26rpx;
  padding: 6rpx;
}

/* 空购物车 */
.go-shopping {
  margin-top: 36rpx;
}

/* 收货信息 */
.contact {
  margin: 20rpx 24rpx 0;
  padding-bottom: 10rpx;
}
.contact-title {
  font-size: 30rpx;
  font-weight: 700;
  padding: 26rpx 28rpx 10rpx;
}

/* 底部结算栏 */
.settle-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 104rpx;
  background: #ffffff;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.06);
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 24rpx;
  z-index: 50;
  padding-bottom: env(safe-area-inset-bottom);
}
.settle-total {
  font-size: 26rpx;
  color: var(--text-2);
}
.settle-price {
  font-size: 40rpx;
  font-weight: 800;
}
.settle-btn {
  width: 240rpx;
}
