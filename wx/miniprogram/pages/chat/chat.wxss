/* AI 客服 · 极简橙 */
.chat-page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  background: #f5f5f5;
}

/* 顶栏 */
.chat-top {
  background: var(--brand-grad);
  padding: 28rpx 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-shrink: 0;
}
.chat-brand {
  display: flex;
  align-items: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: 700;
}
.chat-logo {
  width: 60rpx;
  height: 60rpx;
  border-radius: 14rpx;
  margin-right: 14rpx;
  background: #fff;
}
.chat-top-actions {
  display: flex;
  gap: 14rpx;
}
.new-btn {
  font-size: 23rpx;
  color: #fff;
  border: 2rpx solid rgba(255, 255, 255, 0.7);
  border-radius: 30rpx;
  padding: 8rpx 20rpx;
}

/* 消息区 */
.msg-scroll {
  flex: 1;
  min-height: 0;
}
.msg-list {
  padding: 24rpx;
}
.msg-row {
  display: flex;
  align-items: flex-start;
  margin-bottom: 28rpx;
}
.msg-user {
  flex-direction: row-reverse;
}
.msg-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 14rpx;
  flex-shrink: 0;
  background: #fff;
}
.msg-bubble {
  max-width: 480rpx;
  margin-left: 18rpx;
  padding: 20rpx 24rpx;
  background: #ffffff;
  border-radius: 8rpx 24rpx 24rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.msg-user .msg-bubble {
  margin-left: 0;
  margin-right: 18rpx;
  background: var(--brand-grad);
  color: #fff;
  border-radius: 24rpx 8rpx 24rpx 24rpx;
}
.msg-text {
  font-size: 28rpx;
  line-height: 1.6;
  word-break: break-all;
}

/* 商品卡片 */
.card-row {
  display: flex;
  flex-wrap: wrap;
  gap: 14rpx;
  margin-top: 16rpx;
}
.msg-card {
  width: 200rpx;
  background: var(--brand-bg);
  border: 2rpx solid #ffd9bf;
  border-radius: 10rpx;
  padding: 14rpx;
}
.msg-card-title {
  font-size: 22rpx;
  color: var(--text-2);
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}
.msg-card-price {
  font-size: 28rpx;
  font-weight: 700;
  color: #ff5000;
  margin-top: 8rpx;
}

/* 引用 */
.cite-row {
  margin-top: 14rpx;
  padding-top: 12rpx;
  border-top: 2rpx dashed var(--line);
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}
.cite-tag {
  font-size: 20rpx;
  color: var(--brand);
  background: var(--brand-bg);
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-right: 10rpx;
}
.cite-item {
  font-size: 20rpx;
  color: var(--muted);
  margin-right: 10rpx;
}

/* 转人工 */
.human-hint {
  margin-top: 12rpx;
  font-size: 23rpx;
  color: var(--brand);
}

/* 输入中动画 */
.typing {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 26rpx 24rpx;
}
.typing .dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #c5c5c5;
  animation: blink 1.2s infinite;
}
.typing .dot:nth-child(2) { animation-delay: 0.2s; }
.typing .dot:nth-child(3) { animation-delay: 0.4s; }
@keyframes blink { 0%, 80%, 100% { opacity: 0.3; } 40% { opacity: 1; } }

/* 输入栏 */
.input-bar {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -4rpx 16rpx rgba(0, 0, 0, 0.05);
}
.chat-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 28rpx;
  font-size: 27rpx;
}
.send-btn {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 40rpx;
  border-radius: 36rpx;
  background: var(--brand-grad);
  color: #fff;
  font-size: 28rpx;
  font-weight: 600;
}
.send-disabled {
  opacity: 0.5;
}
