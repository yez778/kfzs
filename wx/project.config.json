{
  "appid": "touristappid",
  "compileType": "miniprogram",
  "projectname": "xingtu-miniprogram",
  "miniprogramRoot": "miniprogram/",
  "libVersion": "3.5.0",
  "setting": {
    "useCompilerPlugins": [
      "typescript"
    ],
    "es6": true,
    "enhance": true,
    "postcss": true,
    "minified": true,
    "ignoreUploadUnusedFiles": true,
    "coverView": true,
    "lazyloadPlaceholderEnable": false,
    "preloadBackgroundData": false,
    "autoPrefetch": false,
    "showShadowRootInWxmlPanel": true,
    "packNpmRelationList": [],
    "babelSetting": {
      "ignore": [],
      "disablePlugins": [],
      "outputPath": ""
    }
  },
  "editorSetting": {
    "tabIndent": "insertSpaces",
    "tabSize": 2
  }
}
